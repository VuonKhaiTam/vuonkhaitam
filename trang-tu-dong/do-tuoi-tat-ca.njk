      <h2 class="o-muc-ten"><a href="/do-tuoi/{{ t.ma }}/">{{ t.ten }}</a></h2>
      <p class="phu">{{ t.nhom }}</p>
      <p>{{ t.mo_ta }}</p>
      <p class="phu">{{ soBai }} bài</p>
    </li>
    {%- endfor %}
  </ul>
