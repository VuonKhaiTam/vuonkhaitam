{#- Thanh tiến độ ở đầu mỗi kỳ: tên bộ truyện, "Kỳ 2 / 6", các ô số để nhảy tới kỳ khác,
    nút kỳ trước / kỳ sau. Cần biến: boTruyenNay, bo_truyen, kyKe -#}
{%- set dsKyBo = collections.boTruyen[bo_truyen] or [] -%}
<nav class="tien-do-truyen" aria-label="Các kỳ của bộ truyện {{ boTruyenNay.ten }}" data-bo-truyen="{{ bo_truyen }}">
  <p class="tdt-dau">
    <a class="tdt-bo" href="/truyen/{{ bo_truyen }}/"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6c-2-1.5-5-2-8-1.5v13c3-.5 6 0 8 1.5 2-1.5 5-2 8-1.5v-13c-3-.5-6 0-8 1.5zM12 6v13"/></svg>{{ boTruyenNay.ten }}</a>
    <span class="tdt-vi-tri">Kỳ {{ kyKe.thuTu }}<span class="tdt-tong"> / {{ kyKe.tong }}</span></span>
  </p>
  <ol class="tdt-o">
    {%- for k in dsKyBo %}
    <li><a href="{{ k.url }}" data-url="{{ k.url }}"{% if k.url == page.url %} aria-current="page"{% endif %} title="Kỳ {{ k.data.ky }}: {{ k.data.ten_ky or k.data.title }}"><span class="an-chu">Kỳ </span>{{ k.data.ky }}</a></li>
    {%- endfor %}
    {%- if boTruyenNay.trang_thai != "hoan-thanh" %}<li class="tdt-sap" aria-hidden="true"><span>…</span></li>{% endif %}
  </ol>
</nav>
