{#- Chân trang nền Rừng Sâu -#}
<footer class="chan-trang">
  <div class="khung">
    <div class="chan-trang-dau">
      <img eleventy:ignore class="logo-kem" src="/assets/logo/logo-kem-144.webp" width="72" height="75" alt="" loading="lazy">
      <div>
        <p class="chan-trang-ten"><span class="chan-trang-vuon">Vườn</span> Khai Tâm</p>
        <p class="chan-trang-khau-hieu">{{ site.khau_hieu }}</p>
      </div>
    </div>
    <nav aria-label="Liên kết chân trang">
      <ul class="chan-trang-link">
        {%- for l in dsLoaiBai %}
        <li><a href="{{ l.duong_dan }}">{{ l.ten }}</a></li>
        {%- endfor %}
        <li><a href="/chu-de/">Chủ đề</a></li>
        <li><a href="/do-tuoi/">Độ tuổi</a></li>
        <li><a href="/tu-sach/">Tủ sách</a></li>
        <li><a href="/gioi-thieu/">Giới thiệu</a></li>
        <li><a href="/lien-he/">Liên hệ</a></li>
        <li><a href="/gioi-thieu/#cam-ket-rieng-tu">Cam kết riêng tư</a></li>
      </ul>
    </nav>
    <p>Vườn Khai Tâm là ngôi nhà trên mạng của {{ site.thuong_hieu_me }}.</p>
    {%- if site.lien_he.email %}
    <p>Thư cho Vườn Khai Tâm: <a href="mailto:{{ site.lien_he.email }}">{{ site.lien_he.email }}</a></p>
    {%- endif %}
    <p class="chan-trang-ban-quyen">© {{ site.tac_gia }} — {{ site.thuong_hieu_me }}</p>
  </div>
</footer>
