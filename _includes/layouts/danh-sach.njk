---
layout: layouts/co-so.njk
---
{#- Danh sách bài theo loại (/goc-cha-me/, /truyen/, /hoc-cung-con/, /nhat-ky/). Cần biến: loaiHienTai -#}
{%- set dsBai = collections.theoLoai[loaiHienTai.ma] or [] -%}
{%- set cacNhomLoc = [
  { ma: "tuoi", ten: "Tuổi", muc: dsDoTuoi },
  { ma: "chu-de", ten: "Chủ đề", muc: dsChuDe }
] -%}
<div class="khung">
  <header class="dau-danh-sach">
    <p class="cac-nhan"><span class="nhan nhan-{{ loaiHienTai.nhan }}">{{ loaiHienTai.ten }}</span></p>
    <h1>{{ loaiHienTai.ten }}</h1>
    <p class="mo-ta-lon">{{ loaiHienTai.mo_ta }}</p>
  </header>

  {#- Trang Truyện: mỗi bộ truyện nhiều kỳ là MỘT thẻ (bấm vào ra mục lục), không rải từng kỳ ra lưới.
      Truyện 1 trang vẫn hiện như thẻ bài bình thường. Cả hai nằm chung lưới nên lọc được cùng lúc. -#}
  {%- set laTrangTruyen = loaiHienTai.ma == "truyen" -%}
  {%- if laTrangTruyen %}{% set dsBai = dsBai | truyenMotTrang %}{% endif -%}
  {%- set coBoTruyen = laTrangTruyen and (collections.boTruyen | length) -%}

  {%- if dsBai.length or coBoTruyen %}
  {% include "partials/bo-loc.njk" %}
  <div class="luoi-the" data-luoi-loc>
    {%- set capThe = "h2" %}
    {%- if coBoTruyen %}
    {%- for ma, dsKy in collections.boTruyen %}{% set bt = dsBoTruyen[ma] %}{% if bt %}
    {% include "partials/the-bo-truyen.njk" %}
    {%- endif %}{% endfor %}
    {%- endif %}
    {%- for bai in dsBai %}
    {% include "partials/the-bai.njk" %}
    {%- endfor %}
  </div>
  {%- else %}
  <p class="trong">Mục này chưa có bài. Vườn Khai Tâm đang gieo hạt, anh chị ghé lại sau nhé.</p>
  {%- endif %}
</div>
